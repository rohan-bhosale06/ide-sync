{
  "name": "ide-sync-monorepo",
  "version": "0.5.0",
  "description": "Sync extensions and settings across VS Code-family IDEs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace ide-sync-core && npm run build --workspace ide-sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src packages/*/tests",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "memfs": "^4.9.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.2",
    "tsup": "^8.1.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
