{
  "name": "ide-sync",
  "version": "0.5.0",
  "description": "Sync extensions across VS Code-family IDEs",
  "type": "module",
  "bin": {
    "ide-sync": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "dayjs": "^1.11.20",
    "deepmerge": "^4.3.1",
    "execa": "^9.3.1",
    "fast-json-patch": "^3.1.1",
    "jsonc-parser": "^3.3.1",
    "node-cron": "^4.2.1",
    "node-notifier": "^10.0.1",
    "ora": "^8.0.1",
    "p-limit": "^6.1.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/deepmerge": "^2.1.0",
    "@types/fast-json-patch": "^1.0.4",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/prompts": "^2.4.9",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "memfs": "^4.9.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.2",
    "tsup": "^8.1.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
